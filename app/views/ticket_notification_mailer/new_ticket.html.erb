<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; color: #1a1a1a; margin: 0; padding: 0; background: #f5f5f5; }
    .wrapper { max-width: 600px; margin: 32px auto; background: #fff; border-radius: 8px; overflow: hidden; box-shadow: 0 1px 4px rgba(0,0,0,.08); }
    .header { background: #1c1c1e; padding: 24px 32px; }
    .header h1 { color: #fff; margin: 0; font-size: 18px; font-weight: 600; }
    .badge { display: inline-block; background: #ff6b35; color: #fff; font-size: 12px; font-weight: 700; padding: 3px 10px; border-radius: 20px; margin-top: 6px; letter-spacing: .5px; }
    .body { padding: 28px 32px; }
    .section { margin-bottom: 20px; }
    .label { font-size: 11px; font-weight: 700; color: #888; text-transform: uppercase; letter-spacing: .6px; margin-bottom: 4px; }
    .value { font-size: 15px; color: #1a1a1a; }
    .issue-box { background: #f9f9f9; border-left: 3px solid #ff6b35; padding: 12px 16px; border-radius: 0 6px 6px 0; font-size: 14px; color: #333; line-height: 1.6; }
    .footer { background: #fafafa; border-top: 1px solid #eee; padding: 16px 32px; font-size: 12px; color: #999; }
    .divider { border: none; border-top: 1px solid #eee; margin: 20px 0; }
  </style>
</head>
<body>
  <div class="wrapper">
    <div class="header">
      <h1>New Support Ticket</h1>
      <span class="badge">Ticket #<%= @ticket.id %></span>
    </div>

    <div class="body">
      <div class="section">
        <div class="label">Customer</div>
        <div class="value">
          <% if @customer %>
            <%= [@customer.first_name, @customer.last_name].compact.join(" ").presence || "Anonymous" %>
            <% if @customer.email.present? %>
              &nbsp;&bull;&nbsp;<%= @customer.email %>
            <% end %>
          <% else %>
            Anonymous visitor
          <% end %>
        </div>
      </div>

      <div class="section">
        <div class="label">Subject</div>
        <div class="value"><%= @ticket.subject %></div>
      </div>

      <div class="section">
        <div class="label">Message</div>
        <div class="issue-box"><%= @ticket.issue %></div>
      </div>

      <hr class="divider">

      <div class="section">
        <div class="label">Details</div>
        <div class="value">
          Priority: <strong><%= @ticket.priority&.capitalize || "Normal" %></strong>
          &nbsp;&bull;&nbsp;
          Source: <strong><%= @ticket.source&.humanize || "Chat" %></strong>
          &nbsp;&bull;&nbsp;
          Raised at: <strong><%= @ticket.created_at.strftime("%b %d, %Y %H:%M") %></strong>
        </div>
      </div>
    </div>

    <div class="footer">
      This notification was sent because ticket email notifications are enabled for your store.<br>
      Reply to this email or log in to your dashboard to respond.
    </div>
  </div>
</body>
</html>
