<%
  q           = @shop_origin.to_s
  h           = @host.to_s
  app_key     = ENV.fetch("SHOPIFY_API_KEY", "")
  embed_url   = "https://#{@shop_origin}/admin/themes/current/editor?context=apps&activateAppId=#{app_key}/ai_chat"
  plan_label  = Shop::PLANS.dig(@current_plan.to_s, :name) || "Free"
  has_plan    = @current_plan.present?
%>

<s-page heading="Dashboard" inline-size="large">

  <%# ── Setup guide ── %>
  <s-section id="setup-guide-section">
    <s-grid gap="small">
      <s-grid gap="small-200">
        <s-grid gridTemplateColumns="1fr auto auto" gap="small-300" alignItems="center">
          <s-heading>Setup guide</s-heading>
        </s-grid>
        <s-paragraph>Complete these steps to go live with your AI chat widget.</s-paragraph>
      </s-grid>

      <s-box borderRadius="base" border="base" background="base">
        <%# Step 1 — done %>
        <s-box>
          <s-grid gridTemplateColumns="auto 1fr" gap="base" padding="small" alignItems="center">
           <s-icon type="check-circle" tone="success"></s-icon>
            <s-text type="strong">Install AI Shopper</s-text>
          </s-grid>
        </s-box>

        <s-divider></s-divider>

        <%# Step 2 — enable embed %>
        <s-box>
          <s-grid gridTemplateColumns="auto 1fr auto" gap="base" padding="small" alignItems="center">
            <% if @app_embed_enabled %>
              <s-icon type="check-circle" tone="success"></s-icon>
            <% else %>
              <s-badge>2</s-badge>
            <% end %>
            <s-stack gap="small-200">
              <s-text type="strong">Enable the chat widget</s-text>
              <s-paragraph>Activate the app embed in your theme so the chat widget appears for customers.</s-paragraph>
              <% unless @app_embed_enabled %>
                <s-stack direction="inline" gap="small-200">
                  <s-button variant="primary" href="<%= embed_url %>" target="_blank">Open theme editor</s-button>
                </s-stack>
              <% end %>
            </s-stack>
          </s-grid>
        </s-box>

        <s-divider></s-divider>

        <%# Step 3 — configure bot %>
        <s-box>
          <s-grid gridTemplateColumns="auto 1fr auto" gap="base" padding="small" alignItems="center">
            <s-badge>3</s-badge>
            <s-stack gap="small-200">
              <s-text type="strong">Configure your bot</s-text>
              <s-paragraph>Set your bot's name, personality, and greeting message.</s-paragraph>
              <s-stack direction="inline" gap="small-200">
                <s-button variant="primary" href="/bot_settings?shop=<%= ERB::Util.url_encode(q) %>&host=<%= ERB::Util.url_encode(h) %>&embedded=1">Bot settings</s-button>
              </s-stack>
            </s-stack>
          </s-grid>
        </s-box>

        <s-divider></s-divider>



        <%# Step 4 — knowledge base %>
        <s-box>
          <s-grid gridTemplateColumns="auto 1fr auto" gap="base" padding="small" alignItems="center">
            <s-badge>4</s-badge>
            <s-stack gap="small-200">
              <s-text type="strong">Build your knowledge base</s-text>
              <s-paragraph>Add FAQs, policies, and documents so your AI can answer questions accurately.</s-paragraph>
              <s-stack direction="inline" gap="small-200">
                <s-button variant="primary" href="/knowledge_base?shop=<%= ERB::Util.url_encode(q) %>&host=<%= ERB::Util.url_encode(h) %>&embedded=1">Add knowledge</s-button>
              </s-stack>
            </s-stack>
          </s-grid>
        </s-box>
      </s-box>
    </s-grid>
  </s-section>

 <s-section padding="base">
    <s-grid
      gridTemplateColumns="@container (inline-size <= 400px) 1fr, 1fr auto 1fr auto 1fr auto 1fr "
      gap="small"
    >
      <s-clickable
        href="/conversations?shop=<%= ERB::Util.url_encode(q) %>&host=<%= ERB::Util.url_encode(h) %>&embedded=1"
        paddingBlock="small-400"
        paddingInline="small-100"
        borderRadius="base"
      >
        <s-grid gap="small-300">
          <s-heading>Conversations</s-heading>
          <s-text><%= @conversations_count %></s-text>
        </s-grid>
      </s-clickable>

     

      <s-divider direction="block"></s-divider>

  

      <s-clickable
        href="/tickets?shop=<%= ERB::Util.url_encode(q) %>&host=<%= ERB::Util.url_encode(h) %>&embedded=1"
        paddingBlock="small-400"
        paddingInline="small-100"
        borderRadius="base"
      >
        <s-grid gap="small-300">
          <s-heading>Total Tickets</s-heading>
          <s-text><%= @tickets_count %></s-text>
        </s-grid>
      </s-clickable>

      <s-divider direction="block"></s-divider>

      <s-clickable
        href="/tickets?shop=<%= ERB::Util.url_encode(q) %>&host=<%= ERB::Util.url_encode(h) %>&embedded=1&status=open"
        paddingBlock="small-400"
        paddingInline="small-100"
        borderRadius="base"
      >
        <s-grid gap="small-300">
          <s-heading>Open Tickets</s-heading>
          <s-stack direction="inline" gap="small-200">
            <s-text><%= @open_tickets_count %></s-text>
            
          </s-stack>
        </s-grid>
      </s-clickable>

      <s-divider direction="block"></s-divider>

      <s-clickable
        disabled
        href="#"
        paddingBlock="small-400"
        paddingInline="small-100"
        borderRadius="base"
      >
        <s-grid gap="small-300" >
          <s-heading>Customers</s-heading>
          <s-text><%= @customers_count %></s-text>
        </s-grid>
      </s-clickable>
    </s-grid>
  </s-section>



  <%# ── Callout: plan upsell (dismissible) ── %>
  
  <%# ── Recent conversations ── %>
  <s-section heading="Recent conversations">
    <s-grid gridTemplateColumns="1fr auto" alignItems="center" paddingBlockEnd="small-400">
      <div></div>
      <s-link href="/conversations?shop=<%= ERB::Util.url_encode(q) %>&host=<%= ERB::Util.url_encode(h) %>&embedded=1">View all</s-link>
    </s-grid>

    <% if @recent_conversations.empty? %>
      <s-box padding="base" background="subdued" borderRadius="base">
        <s-stack alignItems="center" gap="small-200">
          <s-paragraph>No conversations yet. Once your chat widget is live, conversations will appear here.</s-paragraph>
          <s-button href="<%= embed_url %>" target="_blank" variant="primary">Enable chat widget</s-button>
        </s-stack>
      </s-box>
    <% else %>
      <s-table variant="auto">
        <s-table-header-row>
          <s-table-header listSlot="primary">Customer</s-table-header>
          <s-table-header>Last message</s-table-header>
          <s-table-header>Status</s-table-header>
          <s-table-header>Time</s-table-header>
        </s-table-header-row>
        <s-table-body>
          <% @recent_conversations.each do |conv| %>
            <%
              customer     = conv.customer
              display_name = if customer
                               [customer.first_name, customer.last_name].compact.join(" ").presence ||
                               customer.email.presence ||
                               "Visitor ##{customer.visitor_id}"
                             else
                               "Anonymous"
                             end
              last_msg   = conv.messages.max_by(&:created_at)
              preview    = last_msg&.content.to_s.strip.truncate(50)
              ts         = conv.last_message_at || conv.created_at
              time_label = if ts > 1.day.ago
                               ts.strftime("%-I:%M %p")
                             elsif ts > 1.week.ago
                               ts.strftime("%a")
                             else
                               ts.strftime("%b %-d")
                             end
              status     = conv.status.presence || "open"
              badge_tone = { "open" => "success", "closed" => "neutral", "resolved" => "info" }.fetch(status, "neutral")
            %>
            <s-table-row
              href="/conversations/<%= conv.id %>?shop=<%= ERB::Util.url_encode(q) %>&host=<%= ERB::Util.url_encode(h) %>&embedded=1"
            >
              <s-table-cell>
                <s-stack direction="inline" gap="small-200" alignItems="center">
                  <s-avatar initials="<%= display_name.chars.first(2).map(&:upcase).join %>" size="small"></s-avatar>
                  <s-text><%= display_name %></s-text>
                </s-stack>
              </s-table-cell>
              <s-table-cell><s-text><%= preview %></s-text></s-table-cell>
              <s-table-cell><s-badge tone="<%= badge_tone %>"><%= status.capitalize %></s-badge></s-table-cell>
              <s-table-cell><s-text><%= time_label %></s-text></s-table-cell>
            </s-table-row>
          <% end %>
        </s-table-body>
      </s-table>
    <% end %>
  </s-section>

  <% unless has_plan %>
    <s-section id="plan-callout-section">
      <s-grid gridTemplateColumns="1fr auto" gap="small-400" alignItems="start">
        <s-grid
          gridTemplateColumns="@container (inline-size <= 480px) 1fr, auto auto"
          gap="base"
          alignItems="center"
        >
          <s-grid gap="small-200">
            <s-heading>Unlock the full power of AI Shopper</s-heading>
            <s-paragraph>Get unlimited conversations, advanced AI responses, and priority support. Try any plan free for 7 days.</s-paragraph>
            <s-stack direction="inline" gap="small-200">
              <s-button href="/plans?shop=<%= ERB::Util.url_encode(q) %>&host=<%= ERB::Util.url_encode(h) %>&embedded=1">View plans</s-button>
              <s-button tone="neutral" variant="tertiary">Learn more</s-button>
            </s-stack>
          </s-grid>
        </s-grid>
        <s-button
          onclick="document.getElementById('plan-callout-section').style.display='none'"
          icon="x"
          tone="neutral"
          variant="tertiary"
          accessibilityLabel="Dismiss"
        ></s-button>
      </s-grid>
    </s-section>
  <% end %>


  <%# ── Featured apps (dismissible) ── %>
  <s-section id="featured-apps-section">
    <s-grid gridTemplateColumns="1fr auto" alignItems="center" paddingBlockEnd="small-400">
      <s-heading>More apps your business might need</s-heading>
      <s-button
        onclick="document.getElementById('featured-apps-section').style.display='none'"
        icon="x"
        tone="neutral"
        variant="tertiary"
        accessibilityLabel="Dismiss featured apps"
      ></s-button>
    </s-grid>

    <s-grid gridTemplateColumns="repeat(auto-fit, minmax(240px, 1fr))" gap="base">
      <s-clickable
        href="https://apps.shopify.com/smart-countdown-timer-2"
        border="base"
        borderRadius="base"
        padding="base"
        inlineSize="100%"
        accessibilityLabel="View Smart Countdown Timer Bar"
      >

  
        <s-grid gridTemplateColumns="auto 1fr auto" alignItems="stretch" gap="base">
          <s-thumbnail
            size="small"
            src="https://cdn.shopify.com/app-store/listing_images/dc6282d4d74b099793f3d3250539bfb7/icon/CP_dhtmKzJIDEAE=.jpeg"
            alt="Smart Countdown Timer Bar icon"
          ></s-thumbnail>
          <s-box>
            <s-heading>Smart Countdown Timer Bar</s-heading>
            <s-paragraph>$2.99/month · Free trial</s-paragraph>
            <s-paragraph>Create urgency with countdown timers to boost conversions.</s-paragraph>
          </s-box>
          <s-stack justifyContent="start">
            <s-button icon="external" accessibilityLabel="View Smart Countdown Timer Bar"></s-button>
          </s-stack>
        </s-grid>
      </s-clickable>

      <s-clickable
        href="https://apps.shopify.com/smart-product-options-1"
        border="base"
        borderRadius="base"
        padding="base"
        inlineSize="100%"
        accessibilityLabel="View SB Product Options"
      >
        <s-grid gridTemplateColumns="auto 1fr auto" alignItems="stretch" gap="base">
          <s-thumbnail
            size="small"
            src="https://cdn.shopify.com/app-store/listing_images/168fbfef086c67a6143f07ae20f946c2/icon/CN3zlvXJspIDEAE=.jpeg"
            alt="SB Product Options icon"
          ></s-thumbnail>
          <s-box>
            <s-heading>SB Product Options, Variants</s-heading>
            <s-paragraph>$2.99–$6.99/month · Free trial</s-paragraph>
            <s-paragraph>Add unlimited custom product options with full design control.</s-paragraph>
          </s-box>
          <s-stack justifyContent="start">
            <s-button icon="external" accessibilityLabel="View SB Product Options"></s-button>
          </s-stack>
        </s-grid>
      </s-clickable>
    </s-grid>
  </s-section>

  <%# ── Footer help ── %>
  <s-stack alignItems="center" paddingBlock="large">
    <s-text>Need help? <s-link href="https://startbitsolutions.freshdesk.com/" target="_blank">Contact support</s-link> or <s-link href="https://startbitsolutions.com/docs" target="_blank">read the docs</s-link>.</s-text>
  </s-stack>

</s-page>

<script>
(function() {
  var verifyBtn = document.getElementById("verify-embed-btn");
  if (!verifyBtn) return;

  verifyBtn.addEventListener("click", function() {
    verifyBtn.setAttribute("disabled", "");
    verifyBtn.textContent = "Verifying…";

    fetch("/home/check_app_embed_status?shop=<%= ERB::Util.url_encode(q) %>", {
      headers: { "X-CSRF-Token": document.querySelector('meta[name="csrf-token"]')?.content || "" }
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
      if (data.success) {
        document.getElementById("embed-warning-section").style.display = "none";
        document.getElementById("embed-success-section").style.display = "";
      } else {
        verifyBtn.removeAttribute("disabled");
        verifyBtn.textContent = "Verify";
        if (window.shopify && window.shopify.toast) {
          window.shopify.toast.show(data.msg || "App embed is not enabled yet.", { isError: true, duration: 4000 });
        } else {
          alert(data.msg || "App embed is not enabled yet.");
        }
      }
    })
    .catch(function() {
      verifyBtn.removeAttribute("disabled");
      verifyBtn.textContent = "Verify";
    });
  });
})();
</script>
