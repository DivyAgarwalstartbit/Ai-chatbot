<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; color: #1a1a1a; margin: 0; padding: 0; background: #f5f5f5; }
    .wrapper { max-width: 600px; margin: 32px auto; background: #fff; border-radius: 8px; overflow: hidden; box-shadow: 0 1px 4px rgba(0,0,0,.08); }
    .header { background: #1c1c1e; padding: 24px 32px; }
    .header h1 { color: #fff; margin: 0; font-size: 18px; font-weight: 600; }
    .badge { display: inline-block; background: #008060; color: #fff; font-size: 12px; font-weight: 700; padding: 3px 10px; border-radius: 20px; margin-top: 6px; letter-spacing: .5px; }
    .body { padding: 28px 32px; }
    .success-box { background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 8px; padding: 24px; text-align: center; margin-bottom: 24px; }
    .count { font-size: 48px; font-weight: 700; color: #008060; line-height: 1; }
    .count-label { font-size: 15px; color: #4b7a62; margin-top: 6px; }
    .label { font-size: 11px; font-weight: 700; color: #888; text-transform: uppercase; letter-spacing: .6px; margin-bottom: 4px; }
    .value { font-size: 15px; color: #1a1a1a; margin-bottom: 16px; }
    .divider { border: none; border-top: 1px solid #eee; margin: 16px 0; }
    .footer { background: #fafafa; border-top: 1px solid #eee; padding: 16px 32px; font-size: 12px; color: #999; }
  </style>
</head>
<body>
  <div class="wrapper">
    <div class="header">
      <h1>Product Sync Completed</h1>
      <span class="badge">AI Shopper</span>
    </div>

    <div class="body">
      <div class="success-box">
        <div class="count"><%= @product_count %></div>
        <div class="count-label"><%= "product".pluralize(@product_count) %> synced successfully</div>
      </div>

      <div class="label">Store</div>
      <div class="value"><%= @shop.shopify_domain %></div>

      <hr class="divider">

      <div class="label">Synced At</div>
      <div class="value"><%= @synced_at.strftime("%d %b %Y, %I:%M %p UTC") %></div>

      <hr class="divider">

      <p style="font-size:14px; color:#444; line-height:1.6; margin:0;">
        Your AI chat widget now has up-to-date product knowledge and can accurately answer
        customer queries about all <strong><%= @product_count %></strong>
        <%= "product".pluralize(@product_count) %> in your store.
      </p>
    </div>

    <div class="footer">
      Sent by <strong>AI Shopper</strong> for <%= @shop.shopify_domain %>.
    </div>
  </div>
</body>
</html>