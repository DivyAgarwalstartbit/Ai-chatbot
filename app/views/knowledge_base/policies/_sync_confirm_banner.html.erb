<%# Locals: policy_type, confirm_url, shop_origin, host %>
<div id="<%= policy_type %>_sync_banner" style="margin-bottom:10px;">
  <div style="
    background: #fff9ec;
    border: 1px solid #e1c37e;
    border-radius: 6px;
    padding: 12px 14px;
    font-size: 12px;
    color: #4a3700;
  ">
    <div style="display:flex;align-items:flex-start;gap:10px;margin-bottom:10px;">
      <svg width="16" height="16" viewBox="0 0 20 20" fill="currentColor" style="flex-shrink:0;margin-top:1px;color:#8a6116;">
        <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
      </svg>
      <div>
        <strong>Replace existing Shopify sync?</strong><br>
        Syncing will replace your previously synced Shopify policy content with the latest version.
        Your manually entered text and uploaded documents are not affected.
      </div>
    </div>
    <div style="display:flex;gap:8px;">
      <%= form_with url: confirm_url, method: :post, local: false,
                    data: { turbo_stream: true } do |f| %>
        <%= f.hidden_field :confirmed, value: "true" %>
        <%= f.hidden_field :policy_type, value: policy_type %>
        <button type="submit" style="
          background: #008060; color: #fff; border: none; border-radius: 4px;
          padding: 6px 14px; font-size: 12px; font-weight: 600; cursor: pointer;
        ">Yes, sync latest version</button>
      <% end %>
      <button type="button"
        onclick="document.getElementById('<%= policy_type %>_sync_banner').innerHTML = '';"
        style="
          background: transparent; color: #4a3700; border: 1px solid #c9a227;
          border-radius: 4px; padding: 6px 14px; font-size: 12px; cursor: pointer;
        ">Cancel</button>
    </div>
  </div>
</div>
