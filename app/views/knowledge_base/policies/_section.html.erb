<%# Locals: policy, policy_type, title, subtitle, form_url, attachment_url, placeholder, shop_origin, host %>
<% policy_key = policy_type.to_s.delete_suffix("_policy") %>

<div data-controller="policy-modal" id="<%= policy_type %>_section_wrapper" style="<%= "margin-top:8px;" unless local_assigns[:first] %>">
  <details class="kb-accordion" id="accordion_<%= policy_key %>">
    <summary>
      <div class="kb-acc-left">
        <div class="kb-acc-title">
          <%= title %>
          <%= render "knowledge_base/bases/policy_badge",
                policy: policy,
                policy_type: policy_type %>
        </div>
        <div class="kb-acc-sub"><%= subtitle %></div>
      </div>
      <svg class="kb-acc-chevron" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
    </summary>

    <div class="kb-acc-body" data-controller="policy-sync">
      <div id="<%= policy_type %>_sync_banner"></div>

      <%= render "knowledge_base/bases/policy_preview",
            policy: policy,
            policy_type: policy_type,
            empty_message: policy_empty_message(policy_type) %>

      <%= render "knowledge_base/bases/policy_summary",
            policy: policy,
            policy_type: policy_type %>

      <%= render "knowledge_base/bases/policy_actions",
            policy: policy,
            policy_type: policy_type,
            shop_origin: shop_origin,
            host: host %>

      <%= render "knowledge_base/bases/policy_attachment",
            policy: policy,
            policy_type: policy_type,
            shop_origin: shop_origin,
            host: host %>

      <form action="<%= attachment_url %>"
            method="post"
            enctype="multipart/form-data"
            id="<%= policy_type %>_attachment_form"
            data-turbo="true"
            data-turbo-stream="true"
            style="display:none;">
        <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
        <input type="file" name="attachment[file]"
               id="<%= policy_type %>_file_input"
               accept=".pdf,.docx,.txt"
               onchange="document.getElementById('<%= policy_type %>_attachment_form').requestSubmit()" />
      </form>
    </div>
  </details>

  <div class="kb-modal-overlay" id="<%= policy_type %>_modal"
       data-policy-modal-target="modal backdrop"
       data-action="click->policy-modal#backdropClick">
    <div class="kb-modal">
      <div class="kb-modal-header">
        <span class="kb-modal-title">Edit <%= title %></span>
        <button class="kb-modal-close" data-action="click->policy-modal#close" aria-label="Close">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor"><path d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"/></svg>
        </button>
      </div>
      <div class="kb-modal-body">
        <%= form_with(
              model: policy,
              url: form_url,
              method: :patch,
              id: "#{policy_type}_form",
              data: { policy_form: true, turbo_stream: true }
            ) do |f| %>
          <%= f.hidden_field :content, id: "#{policy_type}_content_hidden",
                data: { "policy-modal-target": "hidden" } %>
          <s-text-area
            id="<%= policy_type %>_content_textarea"
            label="Policy text"
            placeholder="<%= placeholder %>"
            rows="14"
            autocomplete="off"
            value="<%= ERB::Util.html_escape(policy.content.to_s) %>"
            data-policy-modal-target="textarea"
          ></s-text-area>
        <% end %>
      </div>
      <div class="kb-modal-footer">
        <s-button variant="primary" data-action="click->policy-modal#submit">Save Policy</s-button>
        <s-button variant="tertiary" tone="neutral" data-action="click->policy-modal#close">Cancel</s-button>
      </div>
    </div>
  </div>
</div>
