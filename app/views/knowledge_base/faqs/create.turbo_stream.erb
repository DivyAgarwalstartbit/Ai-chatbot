<% if @faq.errors.any? %>
  <%= turbo_stream.replace "faq_form_error" do %>
    <div id="faq_form_error" data-faq-modal-target="error">
      <s-banner tone="critical" title="Could not save FAQ">
        <% @faq.errors.full_messages.each do |message| %>
          <s-paragraph><%= message %></s-paragraph>
        <% end %>
      </s-banner>
    </div>
  <% end %>
<% else %>
  <%# Append new FAQ %>
  <%= turbo_stream.append "faq_list" do %>
    <%= render "faq", faq: @faq, shop_origin: @shop_origin, host: @host %>
  <% end %>

  <%= turbo_stream.replace "faq_form_error" do %>
    <div id="faq_form_error" data-faq-modal-target="error"></div>
  <% end %>

  <%# Hide empty state %>
  <%= turbo_stream.replace "faq_empty_state" do %>
    <div id="faq_empty_state"></div>
  <% end %>

  <%# Update count badge %>
  <%= turbo_stream.replace "faq_count_badge" do %>
    <span class="kb-badge kb-badge-info" id="faq_count_badge">
      <%= @faqs.size %> <%= @faqs.size == 1 ? "FAQ" : "FAQs" %>
    </span>
  <% end %>

  <script>
    (function() {
      var modal = document.getElementById('faq-form-modal');
      if (modal && typeof modal.hideOverlay === 'function') {
        modal.hideOverlay();
      }
    })();
  </script>
<% end %>
