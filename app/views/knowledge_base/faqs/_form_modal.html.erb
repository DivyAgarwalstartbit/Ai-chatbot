<%# Locals: shop_origin, host, pro %>
<% max_words = local_assigns[:pro] ? 500 : 150 %>
<s-modal id="faq-form-modal" heading="Add FAQ" size="base" data-modal-target="modal">
  <div id="faq_form_error" data-modal-target="error"></div>

  <form
    id="faq_modal_form"
    action="<%= knowledge_base_faqs_path(shop: shop_origin, host: host, embedded: 1) %>"
    method="post"
    data-modal-target="form"
    data-action="turbo:submit-end->modal#submitEnd"
    data-turbo="true"
    data-turbo-stream="true">
    <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
    <input type="hidden" name="_method" value="" disabled data-modal-target="method">
    <input type="hidden" name="training_document[title]" id="faq_modal_title_hidden" data-modal-target="titleHidden">
    <input type="hidden" name="training_document[content]" id="faq_modal_content_hidden" data-modal-target="contentHidden">

    <s-stack gap="base">
      <s-text-field
        id="faq_modal_question_field"
        label="Question"
        placeholder="e.g. What is your return window?"
        autocomplete="off"
        data-modal-target="questionField"
      ></s-text-field>

      <div>
        <s-text-area
          id="faq_modal_answer_field"
          label="Answer"
          placeholder="Provide a clear and helpful answer..."
          rows="5"
          autocomplete="off"
          data-modal-target="answerField"
          data-max-words="<%= max_words %>"
        ></s-text-area>
        <div style="display:flex; justify-content:flex-end; margin-top:4px;">
          <span id="faq_answer_word_count"
                style="font-size:12px; color:#6d7175;"
                data-max="<%= max_words %>">0/<%= max_words %> words</span>
        </div>
      </div>
    </s-stack>
  </form>

  <s-button
    slot="secondary-actions"
    variant="secondary"
    commandFor="faq-form-modal"
    command="--hide"
    data-action="click->modal#close"
  >
    Cancel
  </s-button>
  <s-button
    slot="primary-action"
    variant="primary"
    icon="save"
    data-modal-target="submitButton"
    data-action="click->modal#submit"
  >
    Save FAQ
  </s-button>

  <%# Hidden buttons used by JS to open/close this modal programmatically %>
  <s-button id="faq-form-modal-show"  commandFor="faq-form-modal" command="--show" style="display:none"></s-button>
  <s-button id="faq-form-modal-close" commandFor="faq-form-modal" command="--hide" style="display:none"></s-button>
</s-modal>

<script>
  (function() {
    var maxWords = <%= max_words %>;

    function countWords(text) {
      return text.trim() === '' ? 0 : text.trim().split(/\s+/).length;
    }

    function truncateToWordLimit(text, limit) {
      var words = text.trim().split(/\s+/);
      if (words.length <= limit) return text;
      // Preserve trailing space if user is mid-word — cut to limit words
      return words.slice(0, limit).join(' ');
    }

    function updateWordCount(value) {
      var counter = document.getElementById('faq_answer_word_count');
      if (!counter) return;
      var count = countWords(value);
      counter.textContent = count + '/' + maxWords + ' words';
      if (count >= maxWords) {
        counter.style.color = '#d72c0d';
      } else if (count > maxWords * 0.9) {
        counter.style.color = '#b98900';
      } else {
        counter.style.color = '#6d7175';
      }
    }

    function attachAnswerListener() {
      var field = document.getElementById('faq_modal_answer_field');
      if (!field) return;

      updateWordCount(field.value || '');

      if (field._faqWordCountListener) {
        field.removeEventListener('input', field._faqWordCountListener);
      }
      field._faqWordCountListener = function() {
        var current = field.value || '';
        var count = countWords(current);
        if (count > maxWords) {
          // Truncate and restore cursor at end
          var truncated = truncateToWordLimit(current, maxWords);
          field.value = truncated;
          field.setAttribute('value', truncated);
        }
        updateWordCount(field.value || '');
      };
      field.addEventListener('input', field._faqWordCountListener);
    }

    var modal = document.getElementById('faq-form-modal');
    if (modal) {
      modal.addEventListener('s-show', function() {
        requestAnimationFrame(attachAnswerListener);
      });
    }

    attachAnswerListener();
  })();
</script>
