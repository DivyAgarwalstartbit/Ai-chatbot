<%= turbo_stream.replace "faq_attachment_#{@faq.id}" do %>
  <%= turbo_frame_tag "faq_attachment_#{@faq.id}" do %>
    <%= render "knowledge_base/faq_attachments/attached_file",
          faq: @faq,
          frame_id: "faq_attachment_#{@faq.id}",
          shop_origin: @shop_origin,
          host: @host %>
  <% end %>
<% end %>
