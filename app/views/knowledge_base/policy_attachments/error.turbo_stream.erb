<%= turbo_stream.replace "#{@policy_type}_attachment_section" do %>
  <%= turbo_frame_tag "#{@policy_type}_attachment_section" do %>
    <s-banner tone="critical" dismissible><s-paragraph><%= @error %></s-paragraph></s-banner>
    <%= render "knowledge_base/policy_attachments/upload_form",
          policy: @policy,
          policy_type: @policy_type,
          frame_id: "#{@policy_type}_attachment_section",
          shop_origin: @shop_origin,
          host: @host %>
  <% end %>
<% end %>
