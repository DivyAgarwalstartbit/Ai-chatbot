<%# Locals: policy, policy_type, frame_id, shop_origin, host %>
<% if policy.file.attached? %>
  <s-box border="base" borderRadius="base" padding="base">
    <s-grid gridTemplateColumns="auto 1fr auto" alignItems="center" gap="base">

      <s-box
        background="subdued"
        borderRadius="base"
        padding="small-200"
        style="display:flex;align-items:center;justify-content:center;width:2.5rem;height:2.5rem;">
        <s-icon source="file-pdf" tone="subdued"></s-icon>
      </s-box>

      <s-grid gap="extra-small">
        <s-text fontWeight="semibold"><%= policy.file.filename %></s-text>
        <s-stack direction="inline" gap="small-100" alignItems="center">
          <s-text color="subdued"><%= number_to_human_size(policy.file.byte_size) %></s-text>
          <s-text color="subdued">&middot;</s-text>
          <s-text color="subdued">Uploaded <%= time_ago_in_words(policy.file.created_at) %> ago</s-text>
        </s-stack>
      </s-grid>

      <s-stack direction="inline" gap="small-100">
        <s-button
          variant="tertiary"
          icon="refresh"
          accessibilityLabel="Replace file"
          href="<%= send(:"new_knowledge_base_#{policy_type}_attachment_path", shop: shop_origin, host: host, embedded: 1) %>"
          data-turbo-frame="<%= frame_id %>">Replace</s-button>
        <%= button_to send(:"knowledge_base_#{policy_type}_attachment_path", shop: shop_origin, host: host, embedded: 1),
              method: :delete,
              data: { turbo_frame: frame_id, turbo_confirm: "Remove this file?" },
              form: { style: "display:inline" } do %>
          <s-button variant="tertiary" tone="critical" icon="delete" accessibilityLabel="Delete file" type="submit"></s-button>
        <% end %>
      </s-stack>

    </s-grid>
  </s-box>
<% else %>
  <%= render "knowledge_base/policy_attachments/upload_form",
        policy: policy,
        policy_type: policy_type,
        frame_id: frame_id,
        shop_origin: shop_origin,
        host: host %>
<% end %>
