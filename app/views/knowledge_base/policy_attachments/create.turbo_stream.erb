<%# Replace the attachment area with the policy file card %>
<%= turbo_stream.replace "#{@policy_type}_attachment_area" do %>
  <%= render "knowledge_base/bases/policy_attachment",
        policy: @policy,
        policy_type: @policy_type,
        shop_origin: @shop_origin,
        host: @host %>
<% end %>

<%# Refresh the policy preview so document-sourced empty states are accurate %>
<%= turbo_stream.replace "#{@policy_type}_preview_area" do %>
  <%= render "knowledge_base/bases/policy_preview",
        policy: @policy,
        policy_type: @policy_type,
        empty_message: policy_empty_message(@policy_type) %>
<% end %>

<%# Update the badge to "Configured" %>
<%= turbo_stream.replace "#{@policy_type}_badge" do %>
  <%= render "knowledge_base/bases/policy_badge",
        policy: @policy,
        policy_type: @policy_type %>
<% end %>

<%# Update the compact status and source summary %>
<%= turbo_stream.replace "#{@policy_type}_summary" do %>
  <%= render "knowledge_base/bases/policy_summary",
        policy: @policy,
        policy_type: @policy_type %>
<% end %>

<%# Hide the "Upload Document" button by replacing actions %>
<%= turbo_stream.replace "#{@policy_type}_actions" do %>
  <%= render "knowledge_base/bases/policy_actions",
        policy: @policy,
        policy_type: @policy_type,
        shop_origin: @shop_origin,
        host: @host %>
<% end %>
