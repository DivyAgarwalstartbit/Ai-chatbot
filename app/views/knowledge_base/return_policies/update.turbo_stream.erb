<%# 1. Update the preview area inside the accordion body %>
<%= turbo_stream.replace "return_policy_preview_area" do %>
  <%= render "knowledge_base/bases/policy_preview",
        policy: @return_policy,
        policy_type: "return_policy",
        empty_message: policy_empty_message("return_policy") %>
<% end %>

<%= turbo_stream.replace "return_policy_badge" do %>
  <%= render "knowledge_base/bases/policy_badge",
        policy: @return_policy,
        policy_type: "return_policy" %>
<% end %>

<%= turbo_stream.replace "return_policy_summary" do %>
  <%= render "knowledge_base/bases/policy_summary",
        policy: @return_policy,
        policy_type: "return_policy" %>
<% end %>

<script>
  (function() {
    var overlay = document.getElementById('return_policy_modal');
    if (overlay) {
      overlay.style.display = 'none';
      document.body.style.overflow = '';
    }
  })();
</script>
