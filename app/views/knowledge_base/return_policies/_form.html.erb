<%= form_with(
  model: return_policy,
  url: knowledge_base_return_policy_path(shop: shop_origin, host: host, embedded: 1),
  method: :patch,
  data: { turbo_frame: "return_policy_section" },
  id: "return_policy_form"
) do |f| %>

  <s-grid gap="base">
    <% if return_policy.errors.any? %>
      <s-banner tone="critical">
        <% return_policy.errors.full_messages.each do |msg| %>
          <s-paragraph><%= msg %></s-paragraph>
        <% end %>
      </s-banner>
    <% end %>

    <s-banner tone="info">
      <s-paragraph>
        Describe your store's return policy — return window, eligibility conditions, refund process, and any exceptions.
        Your chatbot will use this to answer customer questions.
      </s-paragraph>
    </s-banner>

    <%# Hidden input kept in sync with the s-text-area via JS %>
    <%= f.hidden_field :content, id: "return_policy_content_hidden" %>

    <s-text-area
      id="return_policy_content"
      label="Policy text"
      placeholder="e.g. We accept returns within 30 days of purchase. Items must be unused and in original packaging. Refunds are processed within 5–7 business days..."
      rows="12"
      autocomplete="off"
      value="<%= ERB::Util.html_escape(return_policy.content.to_s) %>"
    ></s-text-area>

    <s-stack direction="inline" gap="small-200">
      <s-button variant="primary" onclick="submitReturnPolicy()">Save policy</s-button>
      <s-button variant="tertiary" tone="neutral"
        href="<%= knowledge_base_root_path(shop: shop_origin, host: host, embedded: 1) %>"
        data-turbo-frame="return_policy_section">Cancel</s-button>
    </s-stack>
  </s-grid>

<% end %>

<script>
  function submitReturnPolicy() {
    var ta = document.getElementById('return_policy_content');
    var hidden = document.getElementById('return_policy_content_hidden');
    if (ta && hidden) hidden.value = ta.value;
    document.getElementById('return_policy_form').requestSubmit();
  }
</script>
