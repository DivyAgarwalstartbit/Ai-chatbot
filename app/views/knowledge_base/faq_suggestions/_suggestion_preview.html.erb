<%# Locals: suggestions (Array of { "question" => ..., "answer" => ... }),
             shop_origin, host
    Renders the review panel inside the faq_suggestion_panel turbo frame. %>

<s-box border="base" borderRadius="base" padding="base">
  <div data-controller="faq-suggestions"
       data-faq-suggestions-suggest-url-value="<%= suggest_knowledge_base_faq_suggestions_path(shop: shop_origin, host: host, embedded: 1) %>"
       data-faq-suggestions-import-url-value="<%= import_knowledge_base_faq_suggestions_path(shop: shop_origin, host: host, embedded: 1) %>">

    <%= form_with url: import_knowledge_base_faq_suggestions_path(shop: shop_origin, host: host, embedded: 1),
                  method: :post,
                  id: "faq_suggestions_import_form" do %>

      <s-grid gap="base">

        <%# ── Header ── %>
        <s-grid gridTemplateColumns="1fr auto" alignItems="start">
          <s-grid gap="extra-small">
            <s-heading element="h3">Suggested FAQs</s-heading>
            <s-paragraph color="subdued">
              <strong><%= suggestions.size %> suggestion<%= suggestions.size == 1 ? "" : "s" %></strong>
              generated from your knowledge base.
              Duplicates of existing FAQs have been removed.
              Select the ones to save, edit any text, then click <strong>Import selected</strong>.
            </s-paragraph>
          </s-grid>
          <s-button
            variant="tertiary"
            tone="neutral"
            data-action="click->faq-suggestions#regenerate">Regenerate</s-button>
        </s-grid>

        <%# ── Bulk selection ── %>
        <s-stack direction="inline" gap="small-300" alignItems="center">
          <s-button variant="tertiary" tone="neutral" id="suggest_select_all" type="button">Select all</s-button>
          <s-button variant="tertiary" tone="neutral" id="suggest_deselect_all" type="button">Deselect all</s-button>
          <s-badge tone="info" id="suggest_selected_count"><%= suggestions.size %> selected</s-badge>
        </s-stack>

        <s-divider></s-divider>

        <%# ── Suggestion rows (reuse the same partial as faq_imports) ── %>
        <div id="faq_suggestion_list">
          <s-grid gap="base">
            <% suggestions.each_with_index do |faq, idx| %>
              <%= render "knowledge_base/faq_imports/preview_row", faq: faq, idx: idx %>
            <% end %>
          </s-grid>
        </div>

        <s-divider></s-divider>

        <%# ── Import error placeholder ── %>
        <div id="faq_suggestion_import_error"></div>

        <%# ── Actions ── %>
        <s-stack direction="inline" gap="small-200">
          <s-button
            variant="primary"
            id="suggest_import_btn"
            type="button"
            data-action="click->faq-suggestions#submitImport"
          >Import selected</s-button>
          <s-button
            variant="tertiary"
            tone="neutral"
            commandFor="faq-suggestions-modal"
            command="--hide"
            data-action="click->faq-suggestions#close"
          >Cancel</s-button>
        </s-stack>

      </s-grid>
    <% end %>
  </div>
</s-box>

<script>
  // ── Select / Deselect all ──────────────────────────────────────────────────
  function updateSuggestSelectedCount() {
    var checkboxes = document.querySelectorAll('#faq_suggestion_list .faq-preview-checkbox');
    var checked    = Array.from(checkboxes).filter(function(c) { return c.checked; }).length;
    var el         = document.getElementById('suggest_selected_count');
    if (el) el.textContent = checked + ' selected';
  }

  document.addEventListener('change', function(e) {
    if (e.target && e.target.classList.contains('faq-preview-checkbox') &&
        e.target.closest('#faq_suggestion_list')) {
      updateSuggestSelectedCount();
    }
  });

  var sa = document.getElementById('suggest_select_all');
  if (sa) sa.addEventListener('click', function() {
    document.querySelectorAll('#faq_suggestion_list .faq-preview-checkbox')
            .forEach(function(c) { c.checked = true; });
    updateSuggestSelectedCount();
  });

  var da = document.getElementById('suggest_deselect_all');
  if (da) da.addEventListener('click', function() {
    document.querySelectorAll('#faq_suggestion_list .faq-preview-checkbox')
            .forEach(function(c) { c.checked = false; });
    updateSuggestSelectedCount();
  });
</script>
