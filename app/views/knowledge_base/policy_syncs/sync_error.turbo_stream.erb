<%# Show an error banner inside the policy accordion, stop loading state %>
<%= turbo_stream.replace "#{@policy_type}_sync_banner" do %>
  <div id="<%= @policy_type %>_sync_banner" style="margin-bottom:10px;">
    <div style="
      background: #fff4f4;
      border: 1px solid #f4c7c3;
      border-radius: 6px;
      padding: 10px 14px;
      display: flex;
      align-items: flex-start;
      gap: 10px;
      font-size: 12px;
      color: #bf0711;
    ">
      <svg width="16" height="16" viewBox="0 0 20 20" fill="currentColor" style="flex-shrink:0;margin-top:1px;">
        <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
      </svg>
      <span><%= @error %></span>
    </div>
  </div>
<% end %>

<script>
  (function() {
    var btn = document.getElementById('<%= @policy_type %>_sync_btn');
    if (btn) { btn.removeAttribute('loading'); btn.removeAttribute('disabled'); }
  })();
</script>
