<% total_faqs = current_shop.training_documents.where(document_type: "faq").count rescue (@imported_faqs.size) %>
<%= render "knowledge_base/faqs/import_success",
      imported_faqs: @imported_faqs,
      total_faqs: total_faqs,
      panel_target: "faq_import_panel",
      panel_partial: "knowledge_base/faq_imports/form_panel",
      modal_id: "faq-import-modal",
      banner_id: "faq_import_success_banner",
      banner_title: "#{@imported_faqs.size} FAQ#{@imported_faqs.size == 1 ? '' : 's'} imported",
      shop_origin: @shop_origin,
      host: @host %>
