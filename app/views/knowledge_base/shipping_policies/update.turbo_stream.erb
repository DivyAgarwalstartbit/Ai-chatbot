<%# 1. Update the preview area inside the accordion body %>
<%= turbo_stream.replace "shipping_policy_preview_area" do %>
  <%= render "knowledge_base/bases/policy_preview",
        policy: @shipping_policy,
        policy_type: "shipping_policy",
        empty_message: policy_empty_message("shipping_policy") %>
<% end %>

<%= turbo_stream.replace "shipping_policy_badge" do %>
  <%= render "knowledge_base/bases/policy_badge",
        policy: @shipping_policy,
        policy_type: "shipping_policy" %>
<% end %>

<%= turbo_stream.replace "shipping_policy_summary" do %>
  <%= render "knowledge_base/bases/policy_summary",
        policy: @shipping_policy,
        policy_type: "shipping_policy" %>
<% end %>

<%# 2. Close the modal via inline JS %>
<%= turbo_stream.after "shipping_policy_preview_area" do %><% end %>
<turbo-stream action="update" target="shipping_policy_modal_closer">
  <template></template>
</turbo-stream>

<script>
  (function() {
    var overlay = document.getElementById('shipping_policy_modal');
    if (overlay) {
      overlay.style.display = 'none';
      document.body.style.overflow = '';
    }
  })();
</script>
