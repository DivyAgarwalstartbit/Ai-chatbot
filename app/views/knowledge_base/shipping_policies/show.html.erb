<%= turbo_frame_tag "shipping_policy_section" do %>
  <%= render "knowledge_base/policies/form",
        policy: @shipping_policy,
        policy_type: "shipping_policy",
        form_url: knowledge_base_shipping_policy_path(shop: @shop_origin, host: @host, embedded: 1),
        frame_id: "shipping_policy_section",
        description: "Describe your store's shipping policy — processing times, carriers, delivery estimates, and any international shipping rules.",
        placeholder: "e.g. We ship all orders within 1-2 business days via USPS. Standard delivery takes 3-5 business days. Free shipping on orders over $50...",
        shop_origin: @shop_origin,
        host: @host %>
<% end %>
