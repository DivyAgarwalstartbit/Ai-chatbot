<%= form_with(
  model: shipping_policy,
  url: knowledge_base_shipping_policy_path(shop: shop_origin, host: host, embedded: 1),
  method: :patch,
  data: { turbo_frame: "shipping_policy_section" },
  id: "shipping_policy_form"
) do |f| %>

  <s-grid gap="base">
    <% if shipping_policy.errors.any? %>
      <s-banner tone="critical">
        <% shipping_policy.errors.full_messages.each do |msg| %>
          <s-paragraph><%= msg %></s-paragraph>
        <% end %>
      </s-banner>
    <% end %>

    <s-banner tone="info">
      <s-paragraph>
        Describe your store's shipping policy — processing times, carriers, delivery estimates, and any international shipping rules.
        Your chatbot will use this to answer customer questions.
      </s-paragraph>
    </s-banner>

    <%# Hidden input kept in sync with the s-text-area via JS %>
    <%= f.hidden_field :content, id: "shipping_policy_content_hidden" %>

    <s-text-area
      id="shipping_policy_content"
      label="Policy text"
      placeholder="e.g. We ship all orders within 1–2 business days via USPS. Standard delivery takes 3–5 business days. Free shipping on orders over $50..."
      rows="12"
      autocomplete="off"
      value="<%= ERB::Util.html_escape(shipping_policy.content.to_s) %>"
    ></s-text-area>

    <s-stack direction="inline" gap="small-200">
      <s-button variant="primary" onclick="submitShippingPolicy()">Save policy</s-button>
      <s-button variant="tertiary" tone="neutral"
        href="<%= knowledge_base_root_path(shop: shop_origin, host: host, embedded: 1) %>"
        data-turbo-frame="shipping_policy_section">Cancel</s-button>
    </s-stack>
  </s-grid>

<% end %>

<script>
  function submitShippingPolicy() {
    var ta = document.getElementById('shipping_policy_content');
    var hidden = document.getElementById('shipping_policy_content_hidden');
    if (ta && hidden) hidden.value = ta.value;
    document.getElementById('shipping_policy_form').requestSubmit();
  }
</script>
