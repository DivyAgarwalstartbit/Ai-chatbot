<% if shipping_policy.persisted? && shipping_policy.content.present? %>
  <s-box background="subdued" borderRadius="base" padding="base">
    <s-text><%= simple_format(shipping_policy.content) %></s-text>
  </s-box>
<% else %>
  <s-box background="subdued" borderRadius="base" padding="base">
    <s-stack direction="inline" gap="small-200" alignItems="center">
      <s-icon source="alert-circle" tone="subdued"></s-icon>
      <s-paragraph color="subdued">
        No shipping policy added yet. Click <strong>Edit</strong> to add one.
      </s-paragraph>
    </s-stack>
  </s-box>
<% end %>
