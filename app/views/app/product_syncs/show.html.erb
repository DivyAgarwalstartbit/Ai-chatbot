<s-page heading="Product Sync">
  <s-banner heading="Improve AI Support Accuracy" tone="info" >
    <s-stack gap="base">
  To help the AI provide more accurate and relevant responses, please complete the Ai product information metafield on the Admin Product page with detailed and up-to-date information, including product specifications, features, and other relevant details.
    </s-stack>
</s-banner>


 <s-section title="Product sync status section">
  <s-section-header title="Product Sync" />

  <s-section-content>

    <s-box
      padding="base"
      border="base"
      border-radius="large-200"
      background="base"
    >

      <s-stack
        direction="inline"
        justify-content="space-between"
        align-items="center"
        gap="base"
      >

        <!-- Left side -->
        <s-stack
          direction="inline"
          gap="base"
          align-items="start"
        >

          <s-stack gap="small">

            <s-text variant="headingMd">
              Sync Shopify Products
            </s-text>

  <s-box max-inline-size="600px">
    <s-text tone="subdued">
      Import your Shopify products to enable AI-powered support. This allows your assistant to access product details and provide accurate answers to customers.

      Only active products can be synced.
    </s-text>
  </s-box>

            <s-stack
              direction="inline"
              gap="small"
              align-items="center"
            >

              <% if @products_synced_at.present? %>
                <s-badge tone="success">Synced</s-badge>
              <% end %>

              <s-text tone="subdued">
                <%= @products_count %> product<%= @products_count == 1 ? "" : "s" %>
              </s-text>

            </s-stack>

            <% if @products_synced_at.present? %>
              <s-text tone="subdued">
                Last synced: <span id="last-synced-time" data-utc="<%= @products_synced_at.utc.iso8601 %>">
                  <%= @products_synced_at.utc.strftime("%d %b %Y, %I:%M %p UTC") %>
                </span>
              </s-text>
            <% end %>

          </s-stack>

        </s-stack>

        <!-- Action: show button only before first sync -->
        <% if @products_synced_at.nil? %>
          <s-button
            id="sync-btn"
            variant="primary"
            onclick="startSync()"
          >
            <span id="sync-btn-text">Sync Products</span>
          </s-button>
        <% end %>

      </s-stack>

    </s-box>

  </s-section-content>
</s-section>


<% if @products_count == 0 %>

  <!-- ===== EMPTY STATE (no products synced at all) ===== -->
  <s-section accessibilityLabel="Empty state section">
    <s-grid gap="base" justifyItems="center" paddingBlock="large-400">

      <s-box maxInlineSize="200px" maxBlockSize="200px">
        <s-image
          maxInlineSize="200px"
          maxBlockSize="200px"
          aspectRatio="1/0.5"
          src="https://cdn.shopify.com/static/images/polaris/patterns/callout.png"
          alt="Empty customers"
        />
      </s-box>

      <s-grid justifyItems="center" maxInlineSize="450px" gap="base">

        <s-stack alignItems="center">
          <s-heading>No Sync Products yet</s-heading>
          <s-paragraph>
            No products found. Sync your products to enable AI-powered support.
          </s-paragraph>
        </s-stack>

        <% if @products_synced_at.nil? %>
          <s-button variant="primary" onclick="startSync()">
            <span id="sync-btn-text-empty">Sync Products</span>
          </s-button>
        <% end %>

      </s-grid>

    </s-grid>
  </s-section>

<% else %>

  <s-section padding="none" accessibilityLabel="Products table section">

    <!-- Search bar — stays fixed, never swapped by AJAX -->
    <s-box padding="base">
      <div style="position:relative;">
        <input
          type="search"
          id="product-search-input"
          value="<%= @search %>"
          placeholder="Search by title or handle…"
          autocomplete="off"
          style="
            width:100%;box-sizing:border-box;
            padding:8px 36px 8px 12px;
            border:1px solid var(--p-color-border,#ccc);
            border-radius:8px;font-size:14px;
            background:var(--p-color-bg-surface,#fff);
            color:var(--p-color-text,#202223);
            outline:none;
          "
          oninput="scheduleSearch(this.value)"
        />
        <span
          id="search-clear-btn"
          onclick="clearSearch()"
          style="
            display:<%= @search.present? ? 'flex' : 'none' %>;
            position:absolute;right:10px;top:50%;transform:translateY(-50%);
            cursor:pointer;align-items:center;justify-content:center;
            color:var(--p-color-text-subdued,#6d7175);font-size:16px;
          "
        >&#x2715;</span>
      </div>
    </s-box>

    <!-- Only this div is swapped on search / pagination -->
    <div id="products-table-container">
      <%= render 'table_content' %>
    </div>

  </s-section>

<% end %>


  <script>
    const syncedEl = document.getElementById("last-synced-time");
    if (syncedEl && syncedEl.dataset.utc) {
      const d = new Date(syncedEl.dataset.utc);
      syncedEl.textContent = d.toLocaleString(undefined, { day: "2-digit", month: "short", year: "numeric", hour: "2-digit", minute: "2-digit" });
    }

    let pollInterval = null;

    function setSyncing(syncing) {
      const btn = document.getElementById("sync-btn");
      const texts = [
        document.getElementById("sync-btn-text"),
        document.getElementById("sync-btn-text-empty")
      ].filter(Boolean);

      texts.forEach(el => {
        el.innerHTML = syncing
          ? `<span style="display:inline-flex;align-items:center;gap:8px;">
               <span style="
                 display:inline-block;width:14px;height:14px;
                 border:2px solid rgba(77, 77, 77, 0.4);
                 border-top-color:#fff;border-radius:50%;
                 animation:spin 0.7s linear infinite;
               "></span>
               Syncing…
             </span>`
          : "Sync Products";
      });

      if (btn) btn.disabled = syncing;
    }

    function startPolling() {
      if (pollInterval) return;
      pollInterval = setInterval(async () => {
        try {
          const token = await window.shopify.idToken();
          const res = await fetch("/app/product_sync/sync_status", {
            headers: { "Authorization": "Bearer " + token }
          });
          const { status } = await res.json();
          if (status !== "syncing") {
            clearInterval(pollInterval);
            pollInterval = null;
            setSyncing(false);
            window.location.reload();
          }
        } catch (_) {}
      }, 2500);
    }

   async function startSync() {
  try {
    setSyncing(true);
    const token = await window.shopify.idToken();
    const res = await fetch("/app/product_sync", {
      method: "POST",
      headers: {
        "Authorization": "Bearer " + token,
        "Content-Type": "application/json"
      }
    });
    startPolling();
  } catch(error) {
    console.error("SYNC ERROR", error);
  }
}

    // Resume loader if a sync is already in progress when the page loads
    (async () => {
      try {
        const token = await window.shopify.idToken();
        const res = await fetch("/app/product_sync/sync_status", {
          headers: { "Authorization": "Bearer " + token }
        });
        const { status } = await res.json();
        if (status === "syncing") {
          setSyncing(true);
          startPolling();
        }
      } catch (_) {}
    })();

    // ── Search & pagination (AJAX — only swaps #products-table-container) ──

    let searchTimer  = null;
    let currentQuery = "<%= j @search %>";

    async function fetchTableContent(query, page) {
      const url = new URL("<%= app_product_sync_path %>", window.location.origin);
      if (query) url.searchParams.set("search", query);
      if (page && page > 1) url.searchParams.set("page", page);

      const res = await fetch(url.toString(), {
        headers: { "X-Requested-With": "XMLHttpRequest" }
      });
      const html = await res.text();
      const container = document.getElementById("products-table-container");
      if (container) container.innerHTML = html;
    }

    function scheduleSearch(value) {
      const clearBtn = document.getElementById("search-clear-btn");
      if (clearBtn) clearBtn.style.display = value ? "flex" : "none";
      clearTimeout(searchTimer);
      searchTimer = setTimeout(() => {
        currentQuery = value;
        fetchTableContent(value, 1);
      }, 400);
    }

    function clearSearch() {
      const input = document.getElementById("product-search-input");
      if (input) {
        input.value = "";
        input.focus();
      }
      const clearBtn = document.getElementById("search-clear-btn");
      if (clearBtn) clearBtn.style.display = "none";
      currentQuery = "";
      fetchTableContent("", 1);
    }

    function fetchPage(page) {
      fetchTableContent(currentQuery, page);
    }
  </script>

  <style>
    @keyframes spin { to { transform: rotate(360deg); } }
  </style>

</s-page>
