<style>
/* ── Tab bar ── */
.inbox-tab-bar {
    display: grid;
    border-bottom: 1px solid #e1e3e5;
    background: #fff;
    flex-shrink: 0;
    grid-template-columns: 1fr 1fr;
    text-align: center;
}
.inbox-tab {
  padding: 10px 18px;
  font-size: 13px;
  font-weight: 500;
  color: #6d7175;
  text-decoration: none;
  border-bottom: 2px solid transparent;
  margin-bottom: -1px;
  white-space: nowrap;
}
.inbox-tab:hover { color: #202223; }
.inbox-tab.is-active { color: #202223; border-bottom-color: #C6A8DC; font-weight: 600; }
.inbox-tab-count {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 18px;
  height: 18px;
  padding: 0 5px;
  border-radius: 9px;
  font-size: 10px;
  font-weight: 600;
  background: #f1f2f3;
  color: #6d7175;
  margin-left: 5px;
  vertical-align: middle;
}
.inbox-tab.is-active .inbox-tab-count { background: #e8e3f0; color: #4a2d6b; }

/* ── Master-detail layout (mirrors conversations) ── */
s-page { --p-space-0: 0; }
.conv-layout {
  display: grid;
  grid-template-columns: 35% 65%;
  height: calc(100vh - 56px);
  overflow: hidden;
  border: 1px solid #e1e3e5;
  border-radius: 8px;
  background: #fff;
}
.conv-left {
  border-right: 1px solid #e1e3e5;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #fff;
}
.conv-left-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 16px 10px;
  flex-shrink: 0;
  border-bottom: 1px solid #e1e3e5;
  background: #fff;
}
.conv-filters {
  padding: 10px 12px;
  border-bottom: 1px solid #f1f2f3;
  flex-shrink: 0;
  background: #f9fafb;
}
.conv-list {
  flex: 1;
  overflow-y: auto;
  overflow-x: hidden;
}

/* ── Ticket row ── */
.conv-row {
  display: block;
  padding: 11px 14px;
  border-bottom: 1px solid #f1f2f3;
  text-decoration: none;
  color: inherit;
  cursor: pointer;
  transition: background 0.12s ease;
 
}
.conv-row:hover { background: #f9fafb; }
.conv-row.is-selected {
  background: #f4f6f8;
  border-left: 3px solid #C6A8DC;
  padding-left: 11px;
}
.conv-row-inner {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  min-width: 0;
}
.conv-row-content {
  flex: 1;
  min-width: 0;
  overflow: hidden;
}
.conv-row-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 6px;
  margin-bottom: 2px;
  min-width: 0;
}

/* Hide scrollbar but keep scrolling */
.conv-list,
#ticket-list,
.conv-right,
#ticket-detail,
.ticket-detail {
  scrollbar-width: none;      /* Firefox */
  -ms-overflow-style: none;   /* IE & old Edge */
}

.conv-list::-webkit-scrollbar,
#ticket-list::-webkit-scrollbar,
.conv-right::-webkit-scrollbar,
#ticket-detail::-webkit-scrollbar,
.ticket-details::-webkit-scrollbar {
  width: 0;
  height: 0;
  display: none;
}
.conv-row-name {
  font-size: 13px;
  font-weight: 600;
  color: #202223;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  flex: 1;
  min-width: 0;
}
.conv-row-time {
  font-size: 11px;
  color: #8c9196;
  white-space: nowrap;
  flex-shrink: 0;
}
.conv-row-preview {
  font-size: 12px;
  color: #6d7175;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-bottom: 6px;
  display: block;
}

/* ── Source chip ── */
.source-chip {
  display: inline-block;
  font-size: 10px;
  font-weight: 500;
  color: #6d7175;
  background: #f1f2f3;
  border-radius: 10px;
  padding: 1px 7px;
  margin-right: 5px;
  vertical-align: middle;
}

/* ── Avatar color palette ── */
.av-0 s-avatar { --avatar-bg: #5c9fdc; }
.av-1 s-avatar { --avatar-bg: #b4637a; }
.av-2 s-avatar { --avatar-bg: #6b8f71; }
.av-3 s-avatar { --avatar-bg: #c8863a; }
.av-4 s-avatar { --avatar-bg: #8267be; }
.av-5 s-avatar { --avatar-bg: #3d8fa3; }

/* ── Right panel ── */
.conv-right {
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #f6f6f7;
  min-width: 0;
}
turbo-frame#ticket-detail {
  display: flex;
  flex-direction: column;
  flex: 1;
  overflow: hidden;
}
.conv-empty-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f6f6f7;
}
</style>

<s-page  inlinesize="large">

  <s-banner heading="Order archived" tone="critical" dismissible>
  If the conversation has been closed by the customer and a ticket is associated with that conversation, any reply will be sent to the email address registered with the user, and the ticket will be closed automatically.

  If the conversation is still open, the reply will be delivered to the customer's conversation endpoint, and the ticket status will remain Open. You must close the ticket manually when the conversation is complete.
</s-banner>

  <div class="conv-layout">

    <!-- ═══════════ LEFT PANEL ═══════════ -->
    <div class="conv-left">

      <!-- Tab bar -->
      <div class="inbox-tab-bar">
        <%= link_to tickets_path(shop: @shop_origin, host: @host, embedded: 1), class: "inbox-tab is-active" do %>
          Tickets <span class="inbox-tab-count"><%= @tickets_count %></span>
        <% end %>
        <%= link_to conversations_path(shop: @shop_origin, host: @host, embedded: 1), class: "inbox-tab" do %>
          Conversations <span class="inbox-tab-count"><%= @conversations_count %></span>
        <% end %>
        
      </div>

      <!-- Panel header -->
      <div class="conv-left-header">
        <div style="font-size:14px;font-weight:700;color:#202223;">Tickets</div>
      </div>

      <!-- Filters -->
      <div class="conv-filters">
        <form id="ticket-filter-form"
              method="get"
              action="<%= tickets_path %>"
              data-turbo-frame="ticket-list">
          <input type="hidden" name="shop"     value="<%= @shop_origin %>">
          <input type="hidden" name="host"     value="<%= @host %>">
          <input type="hidden" name="embedded" value="1">
          <div style="display:flex;gap:7px;align-items:center;">
            <div style="flex:1;">
              <s-text-field
                id="ticket-search"
                name="q"
                value="<%= params[:q] %>"
                placeholder="Search…"
                clearButton
                onInput="ticketSearchDebounce(this)"
                onChange="ticketSearchDebounce(this)"
              ></s-text-field>
            </div>
            <div style="width:130px;flex-shrink:0;">
              <s-select name="status" label="" onchange="this.closest('form').requestSubmit()">
                <s-option value=""            <%= params[:status].blank?               ? "selected" : "" %>>All</s-option>
                <s-option value="open"        <%= params[:status] == "open"        ? "selected" : "" %>>Open</s-option>
                <s-option value="in_progress" <%= params[:status] == "in_progress" ? "selected" : "" %>>In Progress</s-option>
                <s-option value="reopen"    <%= params[:status] == "reopen"    ? "selected" : "" %>>Reopen</s-option>
                <s-option value="closed"      <%= params[:status] == "closed"      ? "selected" : "" %>>Closed</s-option>
              </s-select>
            </div>
          </div>
        </form>
      </div>

      <!-- Ticket list (Turbo Frame so filters update only the list) -->
      <turbo-frame id="ticket-list" class="conv-list" style="display:flex;flex-direction:column;flex:1;overflow-y:auto;overflow-x:hidden;">
        <% if @tickets.empty? %>
          <div style="padding:32px 16px;">
            <s-empty-state heading="No tickets yet">
              <s-text>Tickets appear here when a customer requests human help or the AI escalates a conversation.</s-text>
            </s-empty-state>
          </div>
        <% else %>
          <% @tickets.each_with_index do |ticket, idx| %>
            <%
              customer     = ticket.customer
              display_name = if customer
                               [customer.first_name, customer.last_name].compact.join(" ").presence ||
                               customer.email.presence ||
                               "Visitor ##{customer.visitor_id}"
                             else
                               "No customer"
                             end
              initials = if customer
                           parts = [customer.first_name, customer.last_name].compact
                           parts.map { |p| p[0].upcase }.join.first(2).presence || "?"
                         else
                           "?"
                         end
              ts         = ticket.created_at
              time_label = if ts > 1.day.ago
                               ts.strftime("%-I:%M %p")
                             elsif ts > 1.week.ago
                               ts.strftime("%a")
                             else
                               ts.strftime("%b %-d")
                             end
              status     = ticket.status.presence || "open"
              badge_tone = { "open" => "critical", "in_progress" => "warning", "resolved" => "info", "closed" => "neutral" }.fetch(status, "neutral")
              is_selected = @ticket&.id == ticket.id
              av_class    = "av-#{idx % 6}"
              source_label = { "customer_requested_human" => "Human requested", "ai_escalation" => "AI escalation", "merchant_created" => "Merchant" }.fetch(ticket.source.to_s, nil)
            %>
            <%= link_to ticket_path(ticket, shop: @shop_origin, host: @host, embedded: 1, q: params[:q], status: params[:status]),
                        data: { turbo_frame: "ticket-detail" },
                        class: "conv-row #{is_selected ? 'is-selected' : ''} #{av_class}" do %>
              <div class="conv-row-inner">
                <s-avatar initials="<%= initials %>" size="medium" style="flex-shrink:0;margin-top:1px;"></s-avatar>
                <div class="conv-row-content">
                  <div class="conv-row-top">
                    <span class="conv-row-name"><%= ticket.subject %></span>
                    <span class="conv-row-time"><%= time_label %></span>
                  </div>
                  <span class="conv-row-preview"><%= display_name %></span>
                  <div style="display:flex;align-items:center;gap:4px;flex-wrap:wrap;">
                    <% if source_label %>
                      <span class="source-chip"><%= source_label %></span>
                    <% end %>
                    <s-badge tone="<%= badge_tone %>"><%= status.tr("_", " ").capitalize %></s-badge>
                  </div>
                </div>
              </div>
            <% end %>
          <% end %>
        <% end %>

        <% if @total_pages > 1 %>
          <div style="display:flex;align-items:center;justify-content:space-between;padding:8px 12px;border-top:1px solid #e1e3e5;flex-shrink:0;background:#fff;">
            <s-button
              variant="secondary"
              icon="arrow-left"
              size="slim"
              <%= "disabled" if @current_page <= 1 %>
              onclick="ticketGoToPage(<%= @current_page - 1 %>)">
              Previous
            </s-button>
            <span style="font-size:12px;color:#8c9196;"><%= @current_page %> / <%= @total_pages %></span>
            <s-button
              variant="secondary"
              icon="arrow-right"
              icon-position="end"
              size="slim"
              <%= "disabled" if @current_page >= @total_pages %>
              onclick="ticketGoToPage(<%= @current_page + 1 %>)">
              Next
            </s-button>
          </div>
        <% end %>
      </turbo-frame>
    </div>

    <!-- ═══════════ RIGHT PANEL ═══════════ -->
    <div class="conv-right">
      <turbo-frame id="ticket-detail" class="ticket-details">
        <% if @ticket %>
          <%= render "detail", ticket: @ticket %>
        <% else %>
          <div class="conv-empty-wrap">
            <s-empty-state
              heading="Select a ticket"
              image="https://cdn.shopify.com/s/assets/admin/empty-states/no-orders-c19f40e59ea0c2ecfba65a7c3e578975be2f68ff4d12ec4b4ae8c22bf48d0f99.svg"
            >
              <s-text>Choose a ticket from the list to view details and take action.</s-text>
            </s-empty-state>
          </div>
        <% end %>
      </turbo-frame>
    </div>

  </div>
</s-page>

<script>
  var _ticketSearchTimer;
  function ticketSearchDebounce(el) {
    clearTimeout(_ticketSearchTimer);
    _ticketSearchTimer = setTimeout(function() {
      el.closest('form').requestSubmit();
    }, 350);
  }

  document.addEventListener('click', function(e) {
    var row = e.target.closest('.conv-row');
    if (!row) return;
    var frame = row.closest('#ticket-list');
    if (!frame) return;
    frame.querySelectorAll('.conv-row').forEach(function(r) { r.classList.remove('is-selected'); });
    row.classList.add('is-selected');
  });

  function ticketGoToPage(page) {
    const form   = document.getElementById("ticket-filter-form");
    const url    = new URL(form ? form.action : window.location.href, window.location.origin);
    const q      = form && form.querySelector("[name='q']");
    const status = form && form.querySelector("[name='status']");
    if (q && q.value)           url.searchParams.set("q", q.value);
    if (status && status.value) url.searchParams.set("status", status.value);
    url.searchParams.set("page", page);
    url.searchParams.set("shop",     "<%= @shop_origin %>");
    url.searchParams.set("host",     "<%= @host %>");
    url.searchParams.set("embedded", "1");
    if (window.Turbo) {
      Turbo.visit(url.toString(), { frame: "ticket-list" });
    } else {
      window.location.href = url.toString();
    }
  }
</script>
