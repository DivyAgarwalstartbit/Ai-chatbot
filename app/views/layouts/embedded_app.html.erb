<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="shopify-api-key" content="<%= ShopifyApp.configuration.api_key %>" />
     <script src="https://cdn.shopify.com/shopifycloud/app-bridge.js"></script>
    <% application_name = ShopifyApp.configuration.application_name %>
    <title><%= application_name %></title>
    <%= stylesheet_link_tag 'application' %>
    <% if ShopifyApp.use_webpacker? %>
      <%= javascript_pack_tag 'application', 'data-turbolinks-track': 'reload' %>
    <% elsif ShopifyApp.use_importmap? %>
      <%= javascript_importmap_tags %>
    <% else %>
      <%= javascript_include_tag 'application', "data-turbolinks-track" => true %>
    <% end %>
    <%= csrf_meta_tags %>

     <script src="https://cdn.shopify.com/shopifycloud/polaris.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/intl-tel-input@18.1.1/build/css/intlTelInput.css"/>
<script src="https://cdn.jsdelivr.net/npm/intl-tel-input@18.1.1/build/js/intlTelInput.min.js"></script>
<script src="//cdn.shopify.com/s/assets/external/app.js"></script>

  </head>

  <body>
    <div class="app-wrapper">
      <div class="app-content">
        <main role="main">
          <%= yield %>
        </main>
      </div>
    </div>

      <s-app-nav>
        <s-link href="/"rel="home">Dashboard</s-link>
        <s-link href="/products">Training data</s-link>
        <s-link href="/knowledge_base?shop=<%= ERB::Util.url_encode((@shop_origin || (@current_shopify_session.shop if @current_shopify_session)).to_s) %>&host=<%= ERB::Util.url_encode(@host.to_s) %>&embedded=1">Knowledge base</s-link>
        <s-link href="/collections">Inbox</s-link>
        <s-link href="/customers">Widget settings</s-link>
        <s-link href="/bot_settings?shop=<%= ERB::Util.url_encode((@shop_origin || (@current_shopify_session.shop if @current_shopify_session)).to_s) %>&host=<%= ERB::Util.url_encode(@host.to_s) %>&embedded=1">Chatbot settings</s-link>
      </s-app-nav>

    <%= render 'layouts/flash_messages' %>

    <script src="https://unpkg.com/@shopify/app-bridge@2"></script>

    <%= content_tag(:div, nil, id: 'shopify-app-init', data: {
      api_key: ShopifyApp.configuration.api_key,
      shop_origin: @shop_origin || (@current_shopify_session.shop if @current_shopify_session),
      host: @host,
      debug: Rails.env.development?
    } ) %>

    <% if content_for?(:javascript) %>
      <div id="ContentForJavascript" data-turbolinks-temporary>
        <%= yield :javascript %>
      </div>
    <% end %>
  </body>
</html>
