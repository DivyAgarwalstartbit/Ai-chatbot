<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="shopify-api-key" content="<%= ShopifyApp.configuration.api_key %>" />
     <script src="https://cdn.shopify.com/shopifycloud/app-bridge.js"></script>
    <% application_name = ShopifyApp.configuration.application_name %>
    <title><%= application_name %></title>
    <%= stylesheet_link_tag 'application' %>
    <% if ShopifyApp.use_webpacker? %>
      <%= javascript_pack_tag 'application', 'data-turbolinks-track': 'reload' %>
    <% elsif ShopifyApp.use_importmap? %>
      <%= javascript_importmap_tags %>
    <% else %>
      <%= javascript_include_tag 'application', "data-turbolinks-track" => true %>
    <% end %>
    <%= csrf_meta_tags %>
    <%= action_cable_meta_tag %>
    <script src="/action_cable.js"></script>

     <script src="https://cdn.shopify.com/shopifycloud/polaris.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/intl-tel-input@18.1.1/build/css/intlTelInput.css"/>
<script src="https://cdn.jsdelivr.net/npm/intl-tel-input@18.1.1/build/js/intlTelInput.min.js"></script>

  </head>

  <body>
    <div class="app-wrapper">
      <div class="app-content">
        <main role="main">
          <%= yield %>
          <br><br><br>

          <s-stack alignItems="center" gap="small" direction="inline" justifycontent="center">
            <svg class="Polaris-Icon Polaris-Icon--colorTeal Polaris-Icon--hasBackdrop" viewBox="0 0 20 20" style="width: 20px; height: 20px; flex-shrink: 0;">
              <g fill-rule="evenodd">
                <path d="M6 4.038a2 2 0 1 0-3.999-.001A2 2 0 0 0 6 4.038zm2 0c0 2.21-1.79 4-4 4s-4-1.79-4-4 1.79-4 4-4 4 1.79 4 4zM18 4a2 2 0 1 0-3.999-.001A2 2 0 0 0 18 4zm2 0c0 2.21-1.79 4-4 4s-4-1.79-4-4 1.79-4 4-4 4 1.79 4 4zm-2 12a2 2 0 1 0-3.999-.001A2 2 0 0 0 18 16zm2 0c0 2.21-1.79 4-4 4s-4-1.79-4-4 1.79-4 4-4 4 1.79 4 4zm-14 .038a2 2 0 1 0-3.999-.001A2 2 0 0 0 6 16.038zm2 0c0 2.21-1.79 4-4 4s-4-1.79-4-4 1.79-4 4-4 4 1.79 4 4z"
                  fill-rule="nonzero"></path>
                <path d="M18 10.038a8 8 0 1 1-16 0 8 8 0 0 1 16 0zM10 14c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4z" fill="currentColor"></path>
                <path d="M17 10.038a7 7 0 1 0-14 0 7 7 0 0 0 14 0zm2 0a9 9 0 1 1-18.001-.001A9 9 0 0 1 19 10.038z" fill-rule="nonzero"></path>
                <path d="M13 10.038a3 3 0 1 0-6 0 3 3 0 0 0 6 0zm2 0c0 2.76-2.24 5-5 5s-5-2.24-5-5 2.24-5 5-5 5 2.24 5 5z" fill-rule="nonzero"></path>
                <path d="M13.707 7.707l2-2a1 1 0 0 0-1.414-1.414l-2 2a1 1 0 0 0 1.414 1.414zm-1.414 6l2 2a1 1 0 0 0 1.414-1.414l-2-2a1 1 0 0 0-1.414 1.414zM7.707 6.33l-2-2a1 1 0 0 0-1.414 1.415l2 2a1 1 0 0 0 1.414-1.414zm-1.414 6l-2 2a1 1 0 0 0 1.414 1.415l2-2a1 1 0 0 0-1.414-1.414z"
                  fill-rule="nonzero"></path>
              </g>
            </svg>
            <s-text>Powered by: <s-link href="https://www.startbitsolutions.com" target="_blank">Team Startbit</s-link></s-text>
          </s-stack>
        </main>
      </div>
    </div>

      <s-app-nav>
        <s-link href="/"rel="home">Dashboard</s-link>
        <s-link href="/app/product_sync?shop=<%= ERB::Util.url_encode((@shop_origin || (@current_shopify_session.shop if @current_shopify_session)).to_s) %>&host=<%= ERB::Util.url_encode(@host.to_s) %>&embedded=1">Product sync</s-link>
        <s-link href="/knowledge_base?shop=<%= ERB::Util.url_encode((@shop_origin || (@current_shopify_session.shop if @current_shopify_session)).to_s) %>&host=<%= ERB::Util.url_encode(@host.to_s) %>&embedded=1">Knowledge base</s-link>
        <s-link href="/conversations?shop=<%= ERB::Util.url_encode((@shop_origin || (@current_shopify_session.shop if @current_shopify_session)).to_s) %>&host=<%= ERB::Util.url_encode(@host.to_s) %>&embedded=1">Conversations</s-link>
        <s-link href="/bot_settings?shop=<%= ERB::Util.url_encode((@shop_origin || (@current_shopify_session.shop if @current_shopify_session)).to_s) %>&host=<%= ERB::Util.url_encode(@host.to_s) %>&embedded=1">Chatbot settings</s-link>
        <s-link href="/plans?shop=<%= ERB::Util.url_encode((@shop_origin || (@current_shopify_session.shop if @current_shopify_session)).to_s) %>&host=<%= ERB::Util.url_encode(@host.to_s) %>&embedded=1">Pricing</s-link>
      </s-app-nav>

    <%= render 'layouts/flash_messages' %>


    <%= content_tag(:div, nil, id: 'shopify-app-init', data: {
      api_key: ShopifyApp.configuration.api_key,
      shop_origin: @shop_origin || (@current_shopify_session.shop if @current_shopify_session),
      host: @host,
      debug: Rails.env.development?
    } ) %>

    <% if content_for?(:javascript) %>
      <div id="ContentForJavascript" data-turbolinks-temporary>
        <%= yield :javascript %>
      </div>
    <% end %>
  </body>
</html>
